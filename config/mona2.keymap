#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <37 40>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        left_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <2 3>;
        };

        right_bracket {
            bindings = <&kp BACKSLASH>;
            key-positions = <6 7>;
        };

        left_parenthesis {
            bindings = <&kp LS(NUMBER_8)>;
            key-positions = <12 13>;
        };

        right_parenthesis {
            bindings = <&kp LS(NUMBER_9)>;
            key-positions = <17 18>;
        };

        tab_right_change {
            bindings = <&kp LC(TAB)>;
            key-positions = <8 9>;
        };

        tab_change_left {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <8 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                        &kp T                                                        &kp Y          &kp U  &kp I      &kp O    &lt 3 P
&kp A             &kp S         &kp D         &kp F                        &kp G                                       &kp EXCLAMATION  &kp H          &kp J  &kp K      &kp L    &lt 1 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                        &kp B                        &kp F2         &kp QUESTION     &kp N          &kp M  &kp COMMA  &kp DOT  &kp LS(INTERNATIONAL_1)
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 0 LANGUAGE_2  &lt_to_layer_0 2 LANGUAGE_1  &lt 1 SPACE    &lt 3 ENTER      &kp BACKSPACE                             &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&none             &kp SLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                            &kp F7  &kp F8  &mkp MB5  &mkp MB3  &lt 3 F2
&kp LEFT_BRACKET  &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                    &trans  &none   &none   &mkp MB4  &mkp MB1  &mkp MB2
&trans            &kp SQT    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp UNDERSCORE    &trans  &none   &none   &trans    &trans    &trans
&trans            &trans     &kp NUMBER_0  &trans        &trans        &trans            &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp LS(N2)         &kp POUND       &kp DOLLAR   &kp PERCENT                        &kp LS(N6)  &kp LS(N7)  &kp UNDERSCORE  &kp PLUS       &kp INTERNATIONAL_3
&kp UNDERSCORE   &kp LS(SEMICOLON)  &kp MINUS       &kp LS(SQT)  &kp SLASH               &kp QMARK  &mkp MB3    &mkp MB1    &mkp MB2        &kp SEMICOLON  &kp SQT
&kp F1           &kp F2             &kp F3          &kp F4       &kp F5       &kp F11    &kp F12    &kp F6      &kp F7      &kp F8          &kp F9         &kp F10
&trans           &trans             &kp LEFT_SHIFT  &trans       &trans       &trans     &trans     &trans                                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&none           &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &kp LG(TAB)                                  &none     &kp HOME        &kp UP_ARROW    &kp END          &none
&none           &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &mkp MB4  &mkp MB4  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DEL
&kp LEFT_SHIFT  &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &mkp MB5  &mkp MB5  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&kp LCTRL       &trans              &trans                  &trans                   &trans                   &trans    &trans    &trans                                                     &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &mkp MB3  &mkp MB1  &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &mkp MB4  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
